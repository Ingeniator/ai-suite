l=\"#e6edf3\" font-weight=\"700\" font-size=\"14\">grafana</text>\n    <text x=\"75\" y=\"40\" text-anchor=\"middle\" fill=\"#8b949e\" font-size=\"11\">Dashboards :3000</text>\n  </g>\n  <g id=\"node-blackbox\" transform=\"translate(600,560)\">\n    <rect x=\"0\" y=\"0\" width=\"170\" height=\"54\" rx=\"10\" fill=\"#21262d\" stroke=\"#d29922\" stroke-width=\"1.5\" filter=\"url(#shadow)\"/>\n    <text x=\"85\" y=\"24\" text-anchor=\"middle\" fill=\"#e6edf3\" font-weight=\"700\" font-size=\"14\">blackbox</text>\n    <text x=\"85\" y=\"40\" text-anchor=\"middle\" fill=\"#8b949e\" font-size=\"11\">Probe Exporter :9115</text>\n  </g>\n  <line x1=\"480\" y1=\"114\" x2=\"480\" y2=\"158\" stroke=\"#58a6ff\" stroke-width=\"2\" marker-end=\"url(#arrowBlue)\"/>\n  <path d=\"M420,214 Q320,250 210,288\" fill=\"none\" stroke=\"#58a6ff\" stroke-width=\"2\" marker-end=\"url(#arrowBlue)\"/>\n  <path d=\"M460,214 Q420,250 400,288\" fill=\"none\" stroke=\"#58a6ff\" stroke-width=\"2\" marker-end=\"url(#arrowBlue)\"/>\n  <path d=\"M500,214 Q540,250 560,288\" fill=\"none\" stroke=\"#58a6ff\" stroke-width=\"2\" marker-end=\"url(#arrowBlue)\"/>\n  <path d=\"M230,340 Q370,380 520,354\" fill=\"none\" stroke=\"#d29922\" stroke-width=\"2\" stroke-dasharray=\"6,3\" marker-end=\"url(#arrowOrange)\"/>\n  <text x=\"380\" y=\"372\" text-anchor=\"middle\" fill=\"#d29922\" font-size=\"9\">traces</text>\n  <path d=\"M555,354 Q480,400 445,438\" fill=\"none\" stroke=\"#d29922\" stroke-width=\"2\" stroke-dasharray=\"6,3\" marker-end=\"url(#arrowOrange)\"/>\n  <path d=\"M620,354 Q650,400 670,438\" fill=\"none\" stroke=\"#d29922\" stroke-width=\"2\" stroke-dasharray=\"6,3\" marker-end=\"url(#arrowOrange)\"/>\n  <line x1=\"670\" y1=\"322\" x2=\"718\" y2=\"322\" stroke=\"#d29922\" stroke-width=\"2\" stroke-dasharray=\"6,3\" marker-end=\"url(#arrowOrange)\"/>\n  <path d=\"M180,440 L180,370 Q180,360 170,354\" fill=\"none\" stroke=\"#3fb950\" stroke-width=\"1.2\" stroke-dasharray=\"3,3\" marker-end=\"url(#arrowGreen)\"/>\n  <path d=\"M190,440 Q280,400 330,354\" fill=\"none\" stroke=\"#3fb950\" stroke-width=\"1.2\" stroke-dasharray=\"3,3\" marker-end=\"url(#arrowGreen)\"/>\n  <path d=\"M200,440 Q400,380 540,354\" fill=\"none\" stroke=\"#3fb950\" stroke-width=\"1.2\" stroke-dasharray=\"3,3\" marker-end=\"url(#arrowGreen)\"/>\n  <path d=\"M210,440 Q500,380 760,354\" fill=\"none\" stroke=\"#3fb950\" stroke-width=\"1.2\" stroke-dasharray=\"3,3\" marker-end=\"url(#arrowGreen)\"/>\n  <line x1=\"260\" y1=\"480\" x2=\"338\" y2=\"580\" stroke=\"#d29922\" stroke-width=\"1.5\" stroke-dasharray=\"3,3\" marker-end=\"url(#arrowOrange)\"/>\n  <path d=\"M685,560 Q800,450 810,354\" fill=\"none\" stroke=\"#3fb950\" stroke-width=\"1\" stroke-dasharray=\"2,3\" marker-end=\"url(#arrowGreen)\"/>\n  <g transform=\"translate(20,636)\">\n    <rect x=\"0\" y=\"0\" width=\"920\" height=\"30\" rx=\"6\" fill=\"#161b22\" stroke=\"#30363d\" stroke-width=\"1\"/>\n    <text x=\"460\" y=\"20\" text-anchor=\"middle\" fill=\"#8b949e\" font-size=\"11\">All HTTP traffic carries <tspan fill=\"#58a6ff\" font-weight=\"600\">X-Request-ID</tspan> for distributed tracing across nginx, yallmp, checkr, llogr</text>\n  </g>\n</svg>\n</div>",
        "defaultContent": "No data",
        "everyRow": false,
        "editor": {
          "language": "html",
          "format": "none"
        },
        "renderMode": "data",
        "wrap": true,
        "afterRender": "\nconst container = context.element;\nconst svg = container.querySelector('svg');\nif (!svg) return;\n\nconst services = ['nginx', 'yallmp', 'checkr', 'llogr', 'clickstream'];\nconst status = {};\n\nconst series = (context.panelData && context.panelData.series) || [];\nseries.forEach(function(frame) {\n  const legend = (frame.name || '').toLowerCase();\n  const valField = frame.fields && frame.fields.find(function(f) { return f.type === 'number'; });\n  if (!valField || !valField.values || !valField.values.length) return;\n  const val = valField.values[valField.values.length - 1];\n  services.forEach(function(svc) {\n    if (legend.includes(svc)) status[svc] = val;\n  });\n});\n\nservices.forEach(function(svc) {\n  const color = status[svc] === 1 ? '#3fb950' : (status[svc] === 0 ? '#f85149' : '#8b949e');\n  svg.querySelectorAll('[data-service=\"' + svc + '\"].status-box').forEach(function(el) {\n    el.setAttribute('stroke', color);\n  });\n  svg.querySelectorAll('[data-service=\"' + svc + '\"].status-dot').forEach(function(el) {\n    el.setAttribute('fill', color);\n  });\n});\n",
        "externalStyles": [],
        "styles": ""
