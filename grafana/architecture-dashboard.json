      "options": {
        "content": "<div style=\"width:100%;max-width:960px;margin:0 auto\">\n<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 960 680\" font-family=\"Inter,-apple-system,sans-serif\" font-size=\"13\" style=\"width:100%;height:auto\">\n  <defs>\n    <filter id=\"shadow\" x=\"-4%\" y=\"-4%\" width=\"108%\" height=\"112%\"><feDropShadow dx=\"0\" dy=\"2\" stdDeviation=\"3\" flood-opacity=\"0.10\"/></filter>\n    <linearGradient id=\"bgGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0%\" stop-color=\"#0d1117\"/><stop offset=\"100%\" stop-color=\"#161b22\"/></linearGradient>\n    <marker id=\"arrow\" viewBox=\"0 0 10 6\" refX=\"10\" refY=\"3\" markerWidth=\"8\" markerHeight=\"5\" orient=\"auto\"><path d=\"M0,0 L10,3 L0,6 Z\" fill=\"#8b949e\"/></marker>\n    <marker id=\"arrowBlue\" viewBox=\"0 0 10 6\" refX=\"10\" refY=\"3\" markerWidth=\"8\" markerHeight=\"5\" orient=\"auto\"><path d=\"M0,0 L10,3 L0,6 Z\" fill=\"#58a6ff\"/></marker>\n    <marker id=\"arrowOrange\" viewBox=\"0 0 10 6\" refX=\"10\" refY=\"3\" markerWidth=\"8\" markerHeight=\"5\" orient=\"auto\"><path d=\"M0,0 L10,3 L0,6 Z\" fill=\"#d29922\"/></marker>\n    <marker id=\"arrowGreen\" viewBox=\"0 0 10 6\" refX=\"10\" refY=\"3\" markerWidth=\"8\" markerHeight=\"5\" orient=\"auto\"><path d=\"M0,0 L10,3 L0,6 Z\" fill=\"#3fb950\"/></marker>\n  </defs>\n  <rect width=\"960\" height=\"680\" rx=\"12\" fill=\"url(#bgGrad)\"/>\n  <text x=\"480\" y=\"36\" text-anchor=\"middle\" fill=\"#e6edf3\" font-size=\"18\" font-weight=\"700\">AI Suite \u2014 Architecture &amp; Service Status</text>\n  <g transform=\"translate(720,52)\">\n    <rect x=\"0\" y=\"0\" width=\"220\" height=\"90\" rx=\"8\" fill=\"#21262d\" stroke=\"#30363d\" stroke-width=\"1\"/>\n    <circle cx=\"18\" cy=\"18\" r=\"6\" fill=\"#3fb950\"/><text x=\"32\" y=\"22\" fill=\"#c9d1d9\" font-size=\"11\">Healthy</text>\n    <circle cx=\"120\" cy=\"18\" r=\"6\" fill=\"#f85149\"/><text x=\"134\" y=\"22\" fill=\"#c9d1d9\" font-size=\"11\">Down</text>\n    <line x1=\"14\" y1=\"42\" x2=\"50\" y2=\"42\" stroke=\"#58a6ff\" stroke-width=\"2\" marker-end=\"url(#arrowBlue)\"/>\n    <text x=\"58\" y=\"46\" fill=\"#c9d1d9\" font-size=\"11\">HTTP traffic</text>\n    <line x1=\"14\" y1=\"62\" x2=\"50\" y2=\"62\" stroke=\"#d29922\" stroke-width=\"2\" stroke-dasharray=\"6,3\" marker-end=\"url(#arrowOrange)\"/>\n    <text x=\"58\" y=\"66\" fill=\"#c9d1d9\" font-size=\"11\">Traces / Events</text>\n    <line x1=\"14\" y1=\"82\" x2=\"50\" y2=\"82\" stroke=\"#3fb950\" stroke-width=\"2\" stroke-dasharray=\"3,3\" marker-end=\"url(#arrowGreen)\"/>\n    <text x=\"58\" y=\"86\" fill=\"#c9d1d9\" font-size=\"11\">Metrics scrape</text>\n  </g>\n  <g id=\"node-client\" transform=\"translate(420,70)\">\n    <rect x=\"0\" y=\"0\" width=\"120\" height=\"44\" rx=\"22\" fill=\"#30363d\" stroke=\"#8b949e\" stroke-width=\"1.5\" filter=\"url(#shadow)\"/>\n    <text x=\"60\" y=\"27\" text-anchor=\"middle\" fill=\"#e6edf3\" font-weight=\"600\">Client</text>\n  </g>\n  <g id=\"node-nginx\" transform=\"translate(395,160)\">\n    <rect class=\"status-box\" data-service=\"nginx\" x=\"0\" y=\"0\" width=\"170\" height=\"54\" rx=\"10\" fill=\"#21262d\" stroke=\"#8b949e\" stroke-width=\"2\" filter=\"url(#shadow)\"/>\n    <circle class=\"status-dot\" data-service=\"nginx\" cx=\"20\" cy=\"27\" r=\"7\" fill=\"#8b949e\"/>\n    <text x=\"90\" y=\"24\" text-anchor=\"middle\" fill=\"#e6edf3\" font-weight=\"700\" font-size=\"14\">nginx</text>\n    <text x=\"90\" y=\"40\" text-anchor=\"middle\" fill=\"#8b949e\" font-size=\"11\">gateway :8888</text>\n  </g>\n  <g id=\"node-yallmp\" transform=\"translate(60,290)\">\n    <rect class=\"status-box\" data-service=\"yallmp\" x=\"0\" y=\"0\" width=\"170\" height=\"64\" rx=\"10\" fill=\"#21262d\" stroke=\"#8b949e\" stroke-width=\"2\" filter=\"url(#shadow)\"/>\n    <circle class=\"status-dot\" data-service=\"yallmp\" cx=\"20\" cy=\"20\" r=\"7\" fill=\"#8b949e\"/>\n    <text x=\"90\" y=\"24\" text-anchor=\"middle\" fill=\"#e