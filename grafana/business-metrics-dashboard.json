{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus" },
    { "type": "panel", "id": "timeseries", "name": "Time series" },
    { "type": "panel", "id": "stat", "name": "Stat" },
    { "type": "panel", "id": "piechart", "name": "Pie chart" },
    { "type": "panel", "id": "table", "name": "Table" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge" }
  ],
  "id": null,
  "uid": "business-metrics",
  "title": "Business Metrics",
  "description": "Tenant activity, model usage distribution, validation quality, and cost tracking",
  "tags": ["business", "prometheus", "ai-suite"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "group_id",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(llm_requests_total, group_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "model",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(llm_requests_total{group_id=~\"$group_id\"}, model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "provider",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(llm_requests_total{group_id=~\"$group_id\"}, provider)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "title": "Tenant Activity",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Total LLM Requests",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      },
      "options": { "graphMode": "area", "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum(llm_requests_total{group_id=~\"$group_id\"})",
          "legendFormat": ""
        }
      ]
    },
    {
      "title": "Active Tenants",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "steps": [{ "color": "green", "value": null }] } },
        "overrides": []
      },
      "options": { "graphMode": "none", "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "count(count by (group_id) (rate(llm_requests_total{group_id=~\"$group_id\", group_id!=\"\"}[$__rate_interval]) > 0))",
          "legendFormat": ""
        }
      ]
    },
    {
      "title": "Total Cost",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 50 }, { "color": "red", "value": 200 }] } },
        "overrides": []
      },
      "options": { "graphMode": "area", "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum(llm_cost{group_id=~\"$group_id\"})",
          "legendFormat": ""
        }
      ]
    },
    {
      "title": "Validation Pass Rate",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "green", "value": 0.95 }] }
        },
        "overrides": []
      },
      "options": { "graphMode": "area", "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum(checkr_validation_results_total{status=\"passed\"}) / sum(checkr_validation_results_total)",
          "legendFormat": ""
        }
      ]
    },
    {
      "title": "Requests per Tenant Over Time",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "mean"] } },
      "targets": [
        {
          "expr": "sum by (group_id) (rate(llm_requests_total{group_id=~\"$group_id\", group_id!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{ group_id }}"
        }
      ]
    },
    {
      "title": "Top Tenants by Request Count",
      "type": "bargauge",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "topk(10, sum by (group_id) (llm_requests_total{group_id=~\"$group_id\", group_id!=\"\"}))",
          "legendFormat": "{{ group_id }}"
        }
      ]
    },
    {
      "title": "Model Usage Distribution",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Requests by Model",
      "type": "piechart",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["percent", "value"] }, "pieType": "donut", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum by (model) (llm_requests_total{group_id=~\"$group_id\", model=~\"$model\"})",
          "legendFormat": "{{ model }}"
        }
      ]
    },
    {
      "title": "Requests by Provider",
      "type": "piechart",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["percent", "value"] }, "pieType": "donut", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum by (provider) (llm_requests_total{group_id=~\"$group_id\", provider=~\"$provider\"})",
          "legendFormat": "{{ provider }}"
        }
      ]
    },
    {
      "title": "Model Usage Over Time",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "mean"] } },
      "targets": [
        {
          "expr": "sum by (model) (rate(llm_requests_total{group_id=~\"$group_id\", model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "{{ model }}"
        }
      ]
    },
    {
      "title": "Model Usage by Tenant",
      "type": "table",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": { "sortBy": [{ "displayName": "Value", "desc": true }] },
      "targets": [
        {
          "expr": "sum by (group_id, model) (llm_requests_total{group_id=~\"$group_id\", group_id!=\"\", model=~\"$model\"})",
          "legendFormat": "{{ group_id }} / {{ model }}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "group_id": "Tenant", "model": "Model", "Value": "Requests" } } }
      ]
    },
    {
      "title": "Validation Quality (checkr)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Pass/Fail by Gate",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*passed.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*failed.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] } },
      "targets": [
        {
          "expr": "sum by (gate, status) (rate(checkr_validation_results_total[$__rate_interval]))",
          "legendFormat": "{{ gate }} ({{ status }})"
        }
      ]
    },
    {
      "title": "Pass Rate by Gate Over Time",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "custom": { "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "green", "value": 0.95 }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "min"] } },
      "targets": [
        {
          "expr": "sum by (gate) (rate(checkr_validation_results_total{status=\"passed\"}[$__rate_interval])) / sum by (gate) (rate(checkr_validation_results_total[$__rate_interval]))",
          "legendFormat": "{{ gate }}"
        }
      ]
    },
    {
      "title": "Validation Errors by Code",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 39 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] } },
      "targets": [
        {
          "expr": "sum by (gate, code) (rate(checkr_validation_errors_total[$__rate_interval]))",
          "legendFormat": "{{ gate }} / {{ code }}"
        }
      ]
    },
    {
      "title": "Validation Duration by Gate (p95)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 39 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, gate) (rate(checkr_validation_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{ gate }}"
        }
      ]
    },
    {
      "title": "Cost Tracking",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 47 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Cost per Tenant Over Time",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "lastNotNull"] } },
      "targets": [
        {
          "expr": "sum by (group_id) (rate(llm_cost{group_id=~\"$group_id\", group_id!=\"\"}[$__rate_interval])) * 3600",
          "legendFormat": "{{ group_id }}"
        }
      ]
    },
    {
      "title": "Cost per Model Over Time",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "lastNotNull"] } },
      "targets": [
        {
          "expr": "sum by (model) (rate(llm_cost{group_id=~\"$group_id\", model=~\"$model\"}[$__rate_interval])) * 3600",
          "legendFormat": "{{ model }}"
        }
      ]
    },
    {
      "title": "Cumulative Cost by Tenant",
      "type": "bargauge",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 20 }, { "color": "red", "value": 100 }] }
        },
        "overrides": []
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "topk(10, sum by (group_id) (llm_cost{group_id=~\"$group_id\", group_id!=\"\"}))",
          "legendFormat": "{{ group_id }}"
        }
      ]
    },
    {
      "title": "Cost per Request by Model",
      "type": "bargauge",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.05 }, { "color": "red", "value": 0.5 }] }
        },
        "overrides": []
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum by (model) (llm_cost{model=~\"$model\"}) / sum by (model) (llm_requests_total{model=~\"$model\"}) > 0",
          "legendFormat": "{{ model }}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
